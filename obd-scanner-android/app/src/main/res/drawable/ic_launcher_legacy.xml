<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained launcher icon (background + gauge) for API < 26, where the
     adaptive icon in mipmap-anydpi-v26 does not apply. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded dark background -->
    <path
        android:fillColor="#0B0F14"
        android:pathData="M20,4 L88,4 A16,16 0 0,1 104,20 L104,88 A16,16 0 0,1 88,104 L20,104 A16,16 0 0,1 4,88 L4,20 A16,16 0 0,1 20,4 Z" />

    <!-- Gauge arc -->
    <path
        android:strokeColor="#22D3A6"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M36,70 A24,24 0 1,1 72,70" />

    <!-- Needle -->
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,66 L66,46" />

    <!-- Hub -->
    <path
        android:fillColor="#E5E7EB"
        android:pathData="M54,66 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
