<?xml version="1.0" encoding="utf-8"?>
<!-- A gauge / speedometer glyph on the 108dp adaptive-icon canvas.
     Content is kept within the central 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gauge arc -->
    <path
        android:strokeColor="#22D3A6"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M35,68 A22,22 0 1,1 73,68" />

    <!-- Needle -->
    <path
        android:strokeColor="#E5E7EB"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,64 L64,48" />

    <!-- Hub -->
    <path
        android:fillColor="#E5E7EB"
        android:pathData="M54,64 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
